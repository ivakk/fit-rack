# Copy to .env (or run: ./scripts/setup.sh)
# docker compose loads .env from the repo root automatically.

# --- API gateway (Traefik) ---
GATEWAY_PORT=80
GATEWAY_URL=http://localhost
TRAEFIK_DASHBOARD_PORT=8090
GATEWAY_TRUSTED_SECRET=fitrack-dev-gateway

# --- IAM (auth, JWT) — min 32 chars for HS256 ---
IAM_PORT=8080
IAM_JWT_SECRET=supersecretkeysupersecretkey123456
IAM_JWT_ISSUER=fitrack-iam
IAM_JWT_ACCESS_TTL_MINUTES=60
# Registration passwords: 8–128 chars, at least one letter and one digit

# --- MongoDB ---
MONGO_PORT=27017
MONGO_IAM_DATABASE=fitrack_iam
MONGO_WORKOUT_DATABASE=fitrack_workout

# --- RabbitMQ ---
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=fitrack
RABBITMQ_PASSWORD=fitrack

# --- Workout service (AES-256-GCM at rest; min 32 characters) ---
WORKOUT_ENCRYPTION_KEY=fitrack-dev-workout-encryption-key-32b

# --- Frontend (Next.js → calls GATEWAY_URL) ---
FRONTEND_PORT=3000

# --- Monitoring (Prometheus + Grafana) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Load testing (k6 via make load-test) ---
# K6_VUS=25
# K6_DURATION=3m
# K6_SETUP_USERS=15
