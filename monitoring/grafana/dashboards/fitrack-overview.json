    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP request rate (all)",
      "description": "Total HTTP throughput per service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"iam\"}[$__rate_interval]))",
          "legendFormat": "IAM",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"workout\"}[$__rate_interval]))",
          "legendFormat": "Workout",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP rate by outcome",
      "description": "SUCCESS / client / server errors (Spring outcome tag)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"iam|workout\",outcome=\"SUCCESS\"}[$__rate_interval]))",
          "legendFormat": "2xx SUCCESS",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"iam|workout\",outcome=\"CLIENT_ERROR\"}[$__rate_interval]))",
          "legendFormat": "4xx CLIENT_ERROR",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"iam|workout\",outcome=\"SERVER_ERROR\"}[$__rate_interval]))",
          "legendFormat": "5xx SERVER_ERROR",
          "refId": "C"
        }
      ]
    },
    {
