          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"workout\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"workout\"}[$__rate_interval]))",
